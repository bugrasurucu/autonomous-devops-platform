# ═══════════════════════════════════════════════════════════════════════════
# Orbitron Multi-Cloud Autonomous DevOps Platform — Environment Configuration
# Copy this file to `.env` (and `backend/.env`) before starting the stack.
# ═══════════════════════════════════════════════════════════════════════════

# ─── 1. Database & Core Security [REQUIRED] ─────────────────────────────────
# [REQUIRED] PostgreSQL 16 connection string used by Prisma ORM
DATABASE_URL=postgresql://devops:devops_secret_2026@localhost:5432/devops_platform?schema=public
POSTGRES_PASSWORD=devops_secret_2026

# [REQUIRED in Production] Minimum 32-character secret for signing JWT access tokens
JWT_SECRET=change-me-in-production-min-32-chars!!

# [REQUIRED in Production] Minimum 32-character master key for AES-256-GCM encryption
# Used by backend/src/common/crypto.util.ts to encrypt GitHub & Cloud credentials
ENCRYPTION_KEY=change-me-in-production-32chars!!

# ─── 2. Application URLs & Ports [REQUIRED] ─────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── 3. Redis Cache & Rate Limiter [OPTIONAL — falls back to in-memory] ─────
# Used for distributed rate limiting; gracefully falls back to in-memory map if offline
REDIS_URL=redis://localhost:6379

# ─── 4. LLM & Autonomous Agent Runtime [OPTIONAL — falls back to deterministic engine]
# Google Gemini API key for live LLM reasoning alongside deterministic DevOps tools
GEMINI_API_KEY=
# Optional Kubernetes kagent controller URL (falls back to local agent engine if unreachable)
KAGENT_API_URL=

# ─── 5. GitHub OAuth Integration [OPTIONAL] ─────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/github/callback

# ─── 6. Stripe SaaS Billing [OPTIONAL] ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_WEBHOOK_SECRET=
